{
  "name": "dsh-study-edition-atlas",
  "version": "0.1.0",
  "description": "Incremental, source-grounded study editions: lecture notes, visual atlas, questions and worked solutions for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/",
    "resources/",
    "locale/",
    "docs/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js",
    "format": "prettier --write index.js src test package.json locale",
    "format:check": "prettier --check index.js src test package.json locale",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "fflate": "0.8.3",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "0.17.2",
    "svg-to-pdfkit": "0.1.8"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
